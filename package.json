{
  "name": "sf-companion",
  "version": "0.1.0",
  "private": true,
  "description": "The Software Factory companion site: explorations and reports on Foldkit, Effect, Alchemy, and StyleX.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @sf-companion/web dev",
    "alchemy": "pnpm --filter @sf-companion/infra exec alchemy",
    "build": "turbo run build",
    "bump:checkers": "node scripts/bump-checkers.ts",
    "check": "pnpm run lockfile:check && varlock load && turbo run typecheck typecheck-scripts && ultracite check && oxfmt --check . && scripts/check-exact-pins && scripts/check-rule-table && scripts/check_ci_scope.py && scripts/feature_coverage.py && scripts/check_fixture_scale.py",
    "env:check": "varlock load",
    "fix": "ultracite fix && oxfmt .",
    "lint": "ultracite check && oxfmt --check .",
    "lockfile:check": "pnpm --config.optimistic-repeat-install=false install --frozen-lockfile --offline --lockfile-only --ignore-scripts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "infra:deploy": "pnpm --filter @sf-companion/infra deploy",
    "infra:destroy": "pnpm --filter @sf-companion/infra destroy",
    "infra:dev": "pnpm --filter @sf-companion/infra dev",
    "infra:plan": "pnpm --filter @sf-companion/infra plan",
    "prepare": "effect-tsgo patch && if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi",
    "test": "pnpm test:repo && pnpm test:security-audit && pnpm test:verifier-scripts && turbo run test",
    "test:repo": "vitest run scripts/rules.test.ts",
    "test:security-audit": "node --test skills/security-audit/*.test.cjs",
    "test:verifier-scripts": "python3 -m unittest discover -s scripts -p \"test_*.py\"",
    "typecheck": "turbo run typecheck typecheck-scripts",
    "typecheck:tsc": "turbo run typecheck:tsc typecheck:tsc-scripts",
    "typecheck:tsc-scripts": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "turbo run typecheck:fast typecheck:fast-scripts",
    "typecheck:fast-scripts": "tsrs --noEmit -p tsconfig.json",
    "typecheck-scripts": "effect-tsrs diagnostics --project tsconfig.json --strict --type-check",
    "vendor:agent-sources": "./scripts/vendor-agent-sources.sh"
  },
  "devDependencies": {
    "@effect/tsgo": "0.69.0",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@oxlint/plugins": "1.93.0",
    "@types/node": "24.19.2",
    "@yielded/effect-tsrs": "0.2.3",
    "effect": "4.1.4",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "portless": "0.17.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "turbo": "2.11.11",
    "typescript": "7.0.2",
    "ultracite": "8.2.0",
    "varlock": "1.25.0",
    "vitest": "5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.3.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.18.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.1.2"
  },
  "packageManager": "pnpm@11.3.0"
}
