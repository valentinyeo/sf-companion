#!/bin/sh
set -eu
REPO="$HOME/projects/sf-companion"
SNAPSHOT="$REPO/apps/web/content/feed/chats.json"
ACCOUNT=7865043d9ae730882b77f3d5d670c158
BUCKET=yeoux-site-content
KEY=chats/latest.json
export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:/usr/local/bin:/usr/bin:/bin"

exec 9>"${XDG_RUNTIME_DIR:-/tmp}/sf-companion-chats.lock"
flock -n 9 || { echo "another run is active"; exit 0; }

mkdir -p "$(dirname "$SNAPSHOT")"
python3 "$REPO/tools/collect-chats.py" --out "$SNAPSHOT"

yeo-key --env "Hetzner Wrangler All Access" -- sh -c '
set -eu
export CLOUDFLARE_API_TOKEN="$credential"
unset credential username
curl -sS --fail-with-body --max-time 60 -X PUT \
  "https://api.cloudflare.com/client/v4/accounts/'"$ACCOUNT"'/r2/buckets/'"$BUCKET"'/objects/'"$KEY"'" \
  -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
  -H "Content-Type: application/json" \
  --data-binary @'"$SNAPSHOT"'
' >/dev/null
echo "chats live"
