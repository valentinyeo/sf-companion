#!/usr/bin/env python3
import glob
import json
import re
import sys
from pathlib import Path

EXACT = re.compile(r"^\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?$")
PINNED_FIELDS = (
    "dependencies",
    "devDependencies",
    "optionalDependencies",
    "peerDependencies",
)
WORKSPACE_PROTOCOLS = ("workspace:", "catalog:", "link:", "file:")


def manifests(root):
    found = [Path(root) / "package.json"]
    found.extend(Path(path) for path in sorted(glob.glob(str(Path(root) / "apps/*/package.json"))))
    return [path for path in found if path.is_file()]


def check(root):
    errors = []
    for path in manifests(root):
        name = path.relative_to(root).as_posix()
        manifest = json.loads(path.read_text(encoding="utf-8"))
        for field in PINNED_FIELDS:
            for dependency, version in manifest.get(field, {}).items():
                if version.startswith(WORKSPACE_PROTOCOLS):
                    continue
                if EXACT.match(version) is None:
                    errors.append(
                        f"{name} declares {dependency} as \"{version}\". A range drifts on the next install, and CI installs cold. Fix: pin one exact version in {name}."
                    )
    for error in errors:
        print(error, file=sys.stderr)
    return 1 if errors else 0


def main():
    return check(Path(__file__).resolve().parent.parent)


if __name__ == "__main__":
    sys.exit(main())
