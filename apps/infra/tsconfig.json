{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": ["@effect/vitest"]
      }
    ],
    "allowImportingTsExtensions": true,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ESNext"
  },
  "include": ["alchemy.run.ts", "src/**/*.ts", "test/**/*.ts"]
}
